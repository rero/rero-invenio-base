#!/usr/bin/env bash
# SPDX-FileCopyrightText: Fondation RERO+
# SPDX-License-Identifier: AGPL-3.0-or-later

# Usage:
#   env SEARCH=opensearch ./scripts/test
# COLORS for messages
NC='\033[0m'                    # Default color
INFO_COLOR='\033[1;97;44m'      # Bold + white + blue background
SUCCESS_COLOR='\033[1;97;42m'   # Bold + white + green background
ERROR_COLOR='\033[1;97;41m'     # Bold + white + red background

# MESSAGES
msg() {
  echo -e "${1}" 1>&2
}
# Display a colored message
# More info: https://misc.flogisoft.com/bash/tip_colors_and_formatting
# $1: choosen color
# $2: title
# $3: the message

colored_msg() {
  msg "${1}[${2}]: ${3}${NC}"
}

info_msg() {
  colored_msg "${INFO_COLOR}" "INFO" "${1}"
}

error_msg() {
  colored_msg "${ERROR_COLOR}" "ERROR" "${1}"
}

error_msg+exit() {
    error_msg "${1}" && exit 1
}

success_msg() {
  colored_msg "${SUCCESS_COLOR}" "SUCCESS" "${1}"
}

success_msg+exit() {
  colored_msg "${SUCCESS_COLOR}" "SUCCESS" "${1}" && exit 0
}

# Quit on errors
set -o errexit

# Quit on unbound symbols
set -o nounset

# Compose file describing the services the tests need. It must be passed to
# every docker-services-cli call: the compose project name is derived from the
# file's directory, so a `down` without it targets a different project and would
# leave the container running.
COMPOSE_FILE=./docker-services.yml

# Always bring down docker services
function cleanup() {
    # Note: for now we do not need this for the tests.
    docker-services-cli -f "${COMPOSE_FILE}" down
    echo "Done: $?"
}
trap cleanup EXIT

pip_audit_exceptions=""
add_exceptions() {
  pip_audit_exceptions="$pip_audit_exceptions --ignore-vuln $1"
}

info_msg "Check vulnerabilities:"
# pytest 8.4.2   PYSEC-2026-1845 9.0.3
add_exceptions "PYSEC-2026-1845"
uv run pip-audit ${pip_audit_exceptions}

info_msg "Test formatting:"
uv run poe format --check
info_msg "Test linting:"
uv run poe lint

export OPENSEARCH_VERSION=2.19.6
# `-f` is required: without it docker-services-cli uses the compose file bundled
# in its own package, which sets no path.repo and so cannot host the snapshot
# repositories the tests register.
#
# No `eval "$(... --env)"`: the only variable it exports for --search is
# SEARCH_HOSTS, whose value already equals pytest-invenio's default. Calling the
# CLI directly keeps real boot errors readable and lets `set -o errexit` see a
# failure. Restore the eval form if this script ever starts --db/--mq/--cache,
# which do need their connection variables exported.
docker-services-cli -f "${COMPOSE_FILE}" up --search "${SEARCH:-opensearch}"
info_msg "Tests:"
uv run pytest
cleanup
success_msg+exit "All tests passed!"

